{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm --filter @xioflow/core build && pnpm --filter xioflow build",
    "build:core": "pnpm --filter @xioflow/core build",
    "build:cli": "pnpm --filter xioflow build",
    "test": "pnpm --filter @xioflow/core test && pnpm --filter xioflow test",
    "test:core": "pnpm --filter @xioflow/core test",
    "test:cli": "pnpm --filter xioflow test",
    "lint": "pnpm --filter @xioflow/core lint && pnpm --filter xioflow lint",
    "typecheck": "pnpm --filter @xioflow/core build && pnpm --filter xioflow typecheck",
    "release": "pnpm --filter xioflow release",
    "release:minor": "pnpm --filter xioflow release:minor",
    "release:major": "pnpm --filter xioflow release:major",
    "release:beta": "pnpm --filter xioflow release:beta",
    "release:rc": "pnpm --filter xioflow release:rc",
    "release:promote": "pnpm --filter xioflow release:promote",
    "release:check": "node packages/cli/scripts/release-preflight.js check-versions",
    "release:plan": "node packages/cli/scripts/release-preflight.js publish-plan"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
